# Copy this file to .env.local and fill in the values from your Supabase project settings.
# Dashboard path: Project Settings -> Data API (URL) / API Keys (anon public key)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Dashboard path: Project Settings -> API Keys -> service_role secret key.
# NEVER prefix this with NEXT_PUBLIC_, never import it into client components, and
# never commit the real value - it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=
